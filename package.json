{
  "name": "echoaway",
  "version": "0.0.0",
  "private": true,
  "description": "EchoAway Voice Concierge — Big Berlin Hack prototype",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "yarn workspace @echoaway/web dev",
    "dev:backend": "yarn workspace @echoaway/backend start:dev",
    "dev:voice-agent": "yarn workspace @echoaway/voice-agent dev",
    "dev:mobile": "yarn workspace @echoaway/mobile start",
    "build": "yarn workspaces run build",
    "typecheck": "yarn workspaces run typecheck",
    "test": "yarn workspace @echoaway/types test && yarn workspace @echoaway/app test && yarn workspace @echoaway/ui test && yarn workspace @echoaway/voice-agent test && yarn workspace @echoaway/backend test",
    "test:backend": "yarn workspace @echoaway/backend test",
    "test:app": "yarn workspace @echoaway/app test",
    "test:ui": "yarn workspace @echoaway/ui test",
    "test:voice-agent": "yarn workspace @echoaway/voice-agent test",
    "test:types": "yarn workspace @echoaway/types test",
    "agent:cli": "yarn workspace @echoaway/voice-agent cli",
    "agent:script": "yarn workspace @echoaway/voice-agent script",
    "db:generate": "yarn workspace @echoaway/backend prisma:generate",
    "db:migrate": "yarn workspace @echoaway/backend prisma:migrate:dev",
    "db:reset": "yarn workspace @echoaway/backend prisma:migrate:reset",
    "db:studio": "yarn workspace @echoaway/backend prisma:studio",
    "setup": "yarn install && yarn workspace @echoaway/types build && yarn db:migrate",
    "build:types": "yarn workspace @echoaway/types build",
    "seed": "yarn workspace @echoaway/backend seed:catalog",
    "seed:demo": "yarn workspace @echoaway/backend seed:demo",
    "seed:demo:reset": "yarn workspace @echoaway/backend seed:demo:reset",
    "sanity": "yarn workspace @echoaway/backend sanity"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
