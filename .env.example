# Aggregated example. Each app/* and packages/* may also have its own .env.example.
# Copy to .env (do NOT commit) and fill in.

# --- Backend (apps/backend) ---
DATABASE_URL="file:./dev.db"
BACKEND_PORT=4000

# --- Web (apps/web) ---
VITE_BACKEND_URL=http://localhost:4000

# --- Voice agent (apps/voice-agent) ---
