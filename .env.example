# Single source of truth. Copy this file to `.env` at the monorepo root
# (do NOT commit). All apps load it from here:
#   - apps/web        → via Vite `envDir` set to repo root
#   - apps/backend    → via dotenv loaded from repo root in src/main.ts
#   - apps/voice-agent → via dotenv loaded from repo root in src/index.ts

# --- Backend (apps/backend) ---
DATABASE_URL="file:./dev.db"
BACKEND_PORT=4000

# --- Web (apps/web) ---
VITE_BACKEND_URL=http://localhost:4000

# --- Voice agent (apps/voice-agent) ---
BACKEND_URL=http://localhost:4000
GEMINI_API_KEY=
GRADIUM_API_KEY=
TAVILY_API_KEY=
AICOUSTICS_API_KEY=
