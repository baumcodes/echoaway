# Single source of truth. Copy this file to `.env` at the monorepo root
# (do NOT commit). All apps load it from here:
#   - apps/web        → via Vite `envDir` set to repo root
#   - apps/backend    → via dotenv loaded from repo root in src/main.ts
#   - apps/voice-agent → via dotenv loaded from repo root in src/index.ts

# --- Backend (apps/backend) ---
DATABASE_URL="file:./dev.db"
BACKEND_PORT=4000

# --- Web (apps/web) ---
VITE_BACKEND_URL=http://localhost:4000

# --- LiveKit (apps/backend mints tokens, apps/voice-agent connects, apps/web joins rooms) ---
# Get these from your LiveKit Cloud project at https://cloud.livekit.io/
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Browser-visible copy of LIVEKIT_URL (Vite needs the VITE_ prefix to expose it)
VITE_LIVEKIT_URL=

# --- Voice agent (apps/voice-agent) ---
# Connection + secrets only. All behavior toggles (voice backbone,
# LLM model, conversation fillers, UI ack, etc.) live in code at
# apps/voice-agent/src/config/feature-flags.ts — restart the worker
# to pick up changes.
BACKEND_URL=http://localhost:4000
GEMINI_API_KEY=
GRADIUM_API_KEY=
GRADIUM_VOICE_UID=
TAVILY_API_KEY=
# AICOUSTICS_API_KEY is only needed if @livekit/plugins-ai-coustics requires it.
# Per the Python plugin docs, LiveKit Cloud auth alone is sufficient — verify
# during Phase 6 install. Leave blank until confirmed.
AICOUSTICS_API_KEY=
